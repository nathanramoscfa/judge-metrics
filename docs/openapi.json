      "Provenance": {
        "description": "Where a row's current values came from: one retrieved raw artifact.\n\nThe raw object itself lives in the immutable lake under an internal\nstorage key that is never published; ``raw_sha256`` identifies its\nbytes and ``ingest_run_id`` the run that fetched it.",
        "properties": {
          "external_record_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The artifact's id at the source.",
            "title": "External Record Id"
          },
          "ingest_run_id": {
            "format": "uuid",
            "title": "Ingest Run Id",
            "type": "string"
          },
          "parser_version": {
            "title": "Parser Version",
            "type": "string"
          },
          "raw_sha256": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "title": "Raw Sha256",
            "type": "string"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "source": {
            "description": "Source register key (docs/DATA_SOURCES.md), e.g. `fjc`.",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "external_record_id",
          "retrieved_at",
          "raw_sha256",
          "parser_version",
          "ingest_run_id"
        ],
        "title": "Provenance",
        "type": "object"
      },
