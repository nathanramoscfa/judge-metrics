# .env.example
# Copy to `.env` (untracked) and replace every `change-me`. Docker Compose
# reads this file for the postgres and minio services; the application
# settings (Step 2, pydantic-settings, `JUDGEMETRICS_` prefix) read the
# JUDGEMETRICS_* values. Placeholders only — never put a real value here.

# --- Application -------------------------------------------------------------
# local | test | production. `.env` is loaded only when local.
JUDGEMETRICS_ENV=local
# The application connects as the ingest role by default; the API uses the
# read-only app role and migrations use the admin role (Step 2 wires each).
JUDGEMETRICS_DATABASE_URL=postgresql+psycopg://judgemetrics_ingest:change-me@localhost:5432/judgemetrics # pragma: allowlist secret
# Raw object lake: a local directory (file://) or an S3 bucket (s3://).
JUDGEMETRICS_RAW_STORE_URL=s3://judgemetrics-raw
JUDGEMETRICS_S3_ENDPOINT_URL=http://localhost:9000
JUDGEMETRICS_S3_ACCESS_KEY_ID=change-me
JUDGEMETRICS_S3_SECRET_ACCESS_KEY=change-me
# json | console
JUDGEMETRICS_LOG_FORMAT=console

# --- PostgreSQL (docker-compose.yml: service `postgres`) ---------------------
# Superuser for the local container only; migrations use judgemetrics_admin.
POSTGRES_USER=judgemetrics
POSTGRES_PASSWORD=change-me
POSTGRES_DB=judgemetrics
POSTGRES_PORT=5432
# Passwords for the three roles created by infra/docker/postgres/02-roles.sql.
JUDGEMETRICS_APP_DB_PASSWORD=change-me
JUDGEMETRICS_INGEST_DB_PASSWORD=change-me
JUDGEMETRICS_ADMIN_DB_PASSWORD=change-me

# --- MinIO (docker-compose.yml: services `minio`, `minio-init`) -------------
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
JUDGEMETRICS_RAW_BUCKET=judgemetrics-raw
