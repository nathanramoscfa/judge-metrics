# .env.example
# Copy to `.env` (untracked) and replace every `change-me`. Docker Compose
# reads this file for the postgres, minio, and api services; the application
# settings (src/judgemetrics/config.py, pydantic-settings, `JUDGEMETRICS_`
# prefix) read the JUDGEMETRICS_* values. Placeholders only — never put a
# real value here.

# --- Application -------------------------------------------------------------
# local | test | production. Read from the process environment only; `.env`
# is loaded when it is local (the default) and ignored otherwise.
JUDGEMETRICS_ENV=local
# One URL per database role (infra/docker/postgres/02-roles.sql): the API
# reads as judgemetrics_app, migrations (`uv run poe migrate`) run as
# judgemetrics_admin, and the ingest runner (Step 3) writes as
# judgemetrics_ingest. The passwords must match the *_DB_PASSWORD values
# below. Use the same host port as POSTGRES_PORT.
JUDGEMETRICS_DATABASE_URL=postgresql+psycopg://judgemetrics_app:change-me@localhost:5432/judgemetrics # pragma: allowlist secret
JUDGEMETRICS_ADMIN_DATABASE_URL=postgresql+psycopg://judgemetrics_admin:change-me@localhost:5432/judgemetrics # pragma: allowlist secret
JUDGEMETRICS_INGEST_DATABASE_URL=postgresql+psycopg://judgemetrics_ingest:change-me@localhost:5432/judgemetrics # pragma: allowlist secret
# The scratch database the test suite migrates, fills, and empties
# (infra/docker/postgres/03-test-database.sql creates `judgemetrics_test`,
# owned by the Compose superuser, on `uv run poe up`). Connect as its
# owner: the tests run the migrations here — including the round trip to
# base and back — and reach the app and ingest roles by pointing their two
# URLs above at this database. Unset, the suite runs against the databases
# above and warns once: a local live ingest is then emptied by
# `uv run poe check` (docs/ROADMAP.md, retired known issue).
JUDGEMETRICS_TEST_DATABASE_URL=postgresql+psycopg://judgemetrics:change-me@localhost:5432/judgemetrics_test # pragma: allowlist secret
# Raw object lake: a local directory (file://) or an S3 bucket (s3://).
# With s3://, the ingest runner connects with the two keys below; the
# Compose init job creates that user in MinIO when it differs from the
# root user (the keys may also simply repeat MINIO_ROOT_USER/PASSWORD).
JUDGEMETRICS_RAW_STORE_URL=s3://judgemetrics-raw
JUDGEMETRICS_S3_ENDPOINT_URL=http://localhost:9000
JUDGEMETRICS_S3_ACCESS_KEY_ID=change-me
JUDGEMETRICS_S3_SECRET_ACCESS_KEY=change-me
# json | console
JUDGEMETRICS_LOG_FORMAT=console
# Fernet key that encrypts correction_request.requester_contact at rest.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JUDGEMETRICS_CORRECTION_CONTACT_KEY=change-me
# Pepper for the sha256 hashes of person identifiers (names, dates of birth,
# source participant ids) in the restricted person_identifier table. Any
# long random string; changing it orphans every hash, so back it up with
# the database. Required by `ingest run` and `seed`.
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JUDGEMETRICS_IDENTIFIER_PEPPER=change-me
# The generated synthetic dataset (manifest.json + source/) the `synthetic`
# connector ingests; `uv run poe seed` writes and ingests this directory.
JUDGEMETRICS_SYNTHETIC_DIR=data/synthetic/20260916
# Public API. Set JUDGEMETRICS_TRUST_PROXY=true only behind a reverse proxy
# that overwrites X-Forwarded-For; the /search limiter then keys on the
# address the proxy appended. The limiter refills PER_MINUTE tokens a minute
# into a bucket of BURST and is on everywhere except the test environment
# unless JUDGEMETRICS_SEARCH_RATE_LIMIT_ENABLED says otherwise. The
# pg_trgm similarity threshold applies to /search and the judges `q` filter.
JUDGEMETRICS_TRUST_PROXY=false
JUDGEMETRICS_SEARCH_RATE_LIMIT_PER_MINUTE=60
JUDGEMETRICS_SEARCH_RATE_LIMIT_BURST=10
JUDGEMETRICS_SEARCH_SIMILARITY_THRESHOLD=0.3

# --- PostgreSQL (docker-compose.yml: service `postgres`) ---------------------
# Superuser for the local container only; migrations use judgemetrics_admin.
POSTGRES_USER=judgemetrics
POSTGRES_PASSWORD=change-me
POSTGRES_DB=judgemetrics
POSTGRES_PORT=5432
# Passwords for the three roles created by infra/docker/postgres/02-roles.sql.
JUDGEMETRICS_APP_DB_PASSWORD=change-me
JUDGEMETRICS_INGEST_DB_PASSWORD=change-me
JUDGEMETRICS_ADMIN_DB_PASSWORD=change-me

# --- MinIO (docker-compose.yml: services `minio`, `minio-init`) -------------
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
JUDGEMETRICS_RAW_BUCKET=judgemetrics-raw

# --- API container (docker-compose.yml: service `api`, profile `app`) --------
API_PORT=8000

# --- Web container (docker-compose.yml: service `web`, profile `app`) --------
# The API origin baked into the web image at build time (the in-network
# default is fine when only the web container's server talks to the API).
WEB_PORT=3000
WEB_API_BASE_URL=http://api:8000
